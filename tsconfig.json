{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": ["fixtures", "index.d.ts", "tests/**/*.ts"]
}
