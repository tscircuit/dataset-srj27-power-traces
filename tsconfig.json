{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": [
    "circuits",
    "components",
    "fixtures",
    "index.d.ts",
    "scripts/**/*.tsx",
    "tests/**/*.ts"
  ]
}
