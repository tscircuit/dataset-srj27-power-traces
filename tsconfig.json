{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": ["index.d.ts", "tests/**/*.ts"]
}
